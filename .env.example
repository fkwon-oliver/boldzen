# Zendesk
ZENDESK_SUBDOMAIN=oliversolutions
ZENDESK_EMAIL=product@oliversolutions.com
ZENDESK_API_TOKEN=your_zendesk_api_token

# BoldDesk
BOLDDESK_BASE_URL=https://oliversolutions.bolddesk.com
BOLDDESK_API_KEY=your_bolddesk_api_key
BOLDDESK_BRAND_ID=1
BOLDDESK_TICKET_PORTAL_VALUE=oliversolutions

# PostgreSQL
DATABASE_URL=postgres://migrator:migrator@localhost:5432/migration

# Migration
MIGRATION_BATCH_SIZE=50
LOG_LEVEL=info

# Topic + Tag cleanup
TOPICS_CSV_PATH=data/topics.csv
ORGS_CSV_PATH=data/organizations.csv
BOLDDESK_TOPIC_FIELD_KEY=cf_topic

# Historical-reference custom fields (create in BoldDesk Admin → Ticket Fields)
# Stores the original Zendesk ticket ID on each migrated BoldDesk ticket.
BOLDDESK_ZD_ID_FIELD_KEY=cf_zendesk_id

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_MS=2000

# Pilot — Zendesk custom field IDs (create these in Zendesk Admin → Ticket Fields)
# Set all three before running pilot-handoff.
ZD_FIELD_OWNER_SYSTEM=48839645056539
ZD_FIELD_SYNC_STATE=048839693663899
ZD_FIELD_BOLDDESK_TICKET_ID=48839738090395
PILOT_HANDOFF_TAG=handled_in_bolddesk
PILOT_PENDING_SYNC_TAG=pending_bolddesk_sync
